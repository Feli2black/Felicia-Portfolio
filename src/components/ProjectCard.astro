---
interface Props {
  title: string;
  slug: string;
  disciplineName: string;
  disciplineSlug: string;
  year: number;
  description: string;
  tools?: string[];
  coverImage: string;
}

const { title, slug, disciplineName, disciplineSlug, year, description, tools = [], coverImage } = Astro.props;
---

<article class="card" data-discipline={disciplineSlug}>
  <a class="card-link" href={`/projects/${slug}`} aria-label={`View project: ${title}`}>
    <div class="thumb">
      <img src={coverImage} alt={`${title} cover image`} loading="lazy" width="1200" height="800" />
    </div>
    <div class="body">
      <div class="meta">
        <span>{disciplineName}</span>
        <span>{year}</span>
      </div>
      <h2>{title}</h2>
      <p class="desc">{description}</p>
      {tools.length > 0 && <p class="tools">{tools.join(' · ')}</p>}
      <span class="view">View project <span aria-hidden="true" class="arrow">→</span></span>
    </div>
  </a>
</article>

<style>
  .card {
    border: 1px solid var(--color-border);
    background: #101010;
    animation: fadeUp 0.6s ease both;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  .card[hidden] {
    display: none;
  }
  .card:hover {
    border-color: #4a4a4a;
    transform: translateY(-4px);
  }
  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
    height: 100%;
  }
  .card-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #141414;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .card:hover .thumb img {
    transform: scale(1.05);
  }
  .body {
    padding: 1.1rem 1.1rem 1.3rem;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 0.6rem;
  }
  h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.2;
  }
  .desc {
    margin: 0 0 0.75rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .tools {
    margin: 0 0 1rem;
    font-size: 0.75rem;
    color: #7d7d7d;
  }
  .view {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .arrow {
    display: inline-block;
    transition: transform 0.25s ease;
  }
  .card:hover .arrow {
    transform: translateX(6px);
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
</style>