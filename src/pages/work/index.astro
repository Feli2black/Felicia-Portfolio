---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('disciplines')).sort(
  (a, b) => a.data.order - b.data.order
);
const mains = all.filter((d) => !d.data.parent);
const subsOf = (id: string) => all.filter((d) => d.data.parent === id);
const byId = Object.fromEntries(all.map((d) => [d.id, d]));
const mainOf = (slug: string) => byId[slug]?.data.parent ?? slug;

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.year - a.data.year
);
---

<BaseLayout title="Work" description="Selected work by Felicia Adeogun across creative design, digital product design, media production and marketing.">
  <section class="work">
    <header>
      <p class="eyebrow">Selected Work</p>
      <h1>WORK</h1>
    </header>

    <div class="filters" role="group" aria-label="Filter projects by category">
      <button class="filter active" data-main-filter="all" aria-pressed="true">All</button>
      {mains.map((m) => (
        <button class="filter" data-main-filter={m.id} aria-pressed="false">{m.data.name}</button>
      ))}
    </div>

    {mains.map((m) => subsOf(m.id).length > 0 && (
      <div class="filters sub" role="group" aria-label={`Filter ${m.data.name} by specialisation`} data-sub-group={m.id} hidden>
        <button class="filter active" data-sub-filter="all" data-parent={m.id} aria-pressed="true">All {m.data.name}</button>
        {subsOf(m.id).map((s) => (
          <button class="filter" data-sub-filter={s.id} data-parent={m.id} aria-pressed="false">{s.data.name}</button>
        ))}
      </div>
    ))}

    <div class="grid">
      {projects.map((p) => (
        <div class="item" data-main={mainOf(p.data.discipline)} data-sub={p.data.discipline}>
          <ProjectCard
            title={p.data.title}
            slug={p.data.slug}
            disciplineName={byId[p.data.discipline]?.data.name ?? p.data.discipline}
            disciplineSlug={p.data.discipline}
            year={p.data.year}
            description={p.data.description}
            tools={p.data.tools}
            coverImage={p.data.coverImage}
          />
        </div>
      ))}
    </div>

    <p id="empty" class="empty" hidden>No projects here yet. Check back soon.</p>
  </section>
</BaseLayout>

<script>
  const mainBtns = document.querySelectorAll<HTMLButtonElement>('[data-main-filter]');
  const subGroups = document.querySelectorAll<HTMLElement>('[data-sub-group]');
  const subBtns = document.querySelectorAll<HTMLButtonElement>('[data-sub-filter]');
  const items = document.querySelectorAll<HTMLElement>('.item');
  const empty = document.getElementById('empty');

  let main = 'all';
  let sub = 'all';

  function render() {
    let visible = 0;
    items.forEach((it) => {
      const okMain = main === 'all' || it.dataset.main === main;
      const okSub = sub === 'all' || it.dataset.sub === sub;
      const show = okMain && okSub;
      it.hidden = !show;
      if (show) visible++;
    });
    mainBtns.forEach((b) => {
      const active = b.dataset.mainFilter === main;
      b.classList.toggle('active', active);
      b.setAttribute('aria-pressed', String(active));
    });
    subGroups.forEach((g) => {
      g.hidden = g.dataset.subGroup !== main;
    });
    subBtns.forEach((b) => {
      const active = b.dataset.subFilter === sub;
      b.classList.toggle('active', active);
      b.setAttribute('aria-pressed', String(active));
    });
    if (empty) empty.hidden = visible > 0;

    const key = sub !== 'all' ? sub : main;
    history.replaceState(null, '', key === 'all' ? '/work' : `/work#${key}`);
  }

  mainBtns.forEach((b) =>
    b.addEventListener('click', () => {
      main = b.dataset.mainFilter ?? 'all';
      sub = 'all';
      render();
    })
  );
  subBtns.forEach((b) =>
    b.addEventListener('click', () => {
      sub = b.dataset.subFilter ?? 'all';
      render();
    })
  );

  const hash = location.hash.replace('#', '');
  if (hash) {
    const asMain = document.querySelector(`[data-main-filter="${hash}"]`);
    const asSub = document.querySelector<HTMLElement>(`[data-sub-filter="${hash}"]`);
    if (asMain) {
      main = hash;
    } else if (asSub?.dataset.parent) {
      main = asSub.dataset.parent;
      sub = hash;
    }
  }
  render();
</script>

<style>
  .work {
    max-width: 1280px;
    margin: 0 auto;
    padding: 4rem 1.5rem 2rem;
  }
  .eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  h1 {
    margin: 0 0 2.5rem;
    font-size: clamp(3rem, 10vw, 7rem);
    line-height: 0.95;
    font-weight: 800;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }
  .filters[hidden] {
    display: none;
  }
  .filter {
    background: none;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    padding: 0.6rem 1rem;
    font: inherit;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .filter:hover {
    color: var(--color-text-primary);
    border-color: #4a4a4a;
  }
  .filter.active {
    background: var(--color-text-primary);
    color: var(--color-bg);
    border-color: var(--color-text-primary);
  }
  .filter:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .sub .filter {
    border: 0;
    border-bottom: 1px solid var(--color-border);
    padding: 0.4rem 0.2rem;
    margin-right: 0.8rem;
  }
  .sub .filter.active {
    background: none;
    color: var(--color-text-primary);
    border-bottom-color: var(--color-accent);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  .item > :global(.card) {
    height: 100%;
  }
  .empty {
    color: var(--color-text-secondary);
    padding: 3rem 0;
  }

  @media (max-width: 600px) {
    .filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 0.5rem;
    }
    .filter {
      white-space: nowrap;
    }
  }
</style>